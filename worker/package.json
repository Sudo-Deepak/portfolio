{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "hash": "node scripts/hash-password.mjs",
    "db:init:local": "wrangler d1 execute DB --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute DB --local --file=migrations/0001_add_source_geo.sql",
    "db:migrate:remote": "wrangler d1 execute DB --remote --file=migrations/0001_add_source_geo.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.90.0"
  }
}
