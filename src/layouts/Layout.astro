---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} | ${site.role}`,
  description = site.description,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/android-chrome-512x512.png`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: site.email,
  url: site.url,
  address: { '@type': 'PostalAddress', addressLocality: 'Pune', addressRegion: 'MH', addressCountry: 'IN' },
  sameAs: [site.socials.linkedin, site.socials.github, site.socials.youtube, site.socials.instagram],
  knowsAbout: ['Java', 'Spring Boot', 'Microservices', 'AWS', 'SAP', 'System Design'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta
      name="keywords"
      content="Deepak Kumar, Senior Java Developer, Spring Boot, Microservices, AWS, SAP, Backend Developer, Software Engineer"
    />
    <meta name="theme-color" content="#0b1120" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons / manifest -->
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- No-flash theme: run before paint -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const dark = stored ? stored === 'dark' : true; // default to dark
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <slot />

    <!-- Scroll reveal -->
    <script>
      const reveals = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && reveals.length) {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <!--
      Resume links default to the static /public copy so the download always works
      even if the Worker is down or removed. When the Worker is reachable, upgrade
      the links to its /resume endpoint (latest admin-uploaded PDF).

      The reachability probe fires ONLY when a visitor shows intent to use the
      resume (hover / focus / tap), at most once per page — so the Worker is not
      pinged on every page view and we stay comfortably inside the free tier.
      Most visitors never trigger it. We probe /health, never /resume, because
      /resume logs a download event.
    -->
    <script is:inline define:vars={{ workerUrl: site.workerUrl }}>
      (function () {
        try {
          if (!workerUrl || workerUrl.indexOf('CHANGE-ME') !== -1) return;
          var links = document.querySelectorAll('a[data-resume]');
          if (!links.length) return;

          var base = workerUrl.replace(/\/$/, '');
          var probed = false;

          function upgrade() {
            if (probed) return;
            probed = true; // exactly one Worker request per page, and only on intent
            var ctrl = new AbortController();
            var timer = setTimeout(function () { ctrl.abort(); }, 1500);
            fetch(base + '/health', { method: 'GET', mode: 'cors', signal: ctrl.signal })
              .then(function (res) {
                clearTimeout(timer);
                if (res && res.ok) {
                  links.forEach(function (a) { a.setAttribute('href', base + '/resume'); });
                }
              })
              .catch(function () {
                clearTimeout(timer);
                /* Worker unreachable — keep the static /public link. */
              });
          }

          links.forEach(function (a) {
            a.addEventListener('pointerenter', upgrade, { once: true });
            a.addEventListener('focus', upgrade, { once: true });
            a.addEventListener('touchstart', upgrade, { once: true, passive: true });
          });
        } catch (e) {
          /* never let this break the page */
        }
      })();
    </script>

    <!-- Privacy-friendly analytics beacon → Cloudflare Worker backend. -->
    <script is:inline define:vars={{ workerUrl: site.workerUrl }}>
      (function () {
        try {
          // Skip entirely until the Worker URL is configured in src/data/site.ts.
          if (!workerUrl || workerUrl.indexOf('CHANGE-ME') !== -1) return;
          if (navigator.doNotTrack === '1') return;

          var endpoint = workerUrl.replace(/\/$/, '') + '/collect';

          // Stable, anonymous visitor id for unique-visitor counts (no cookies, no PII).
          var vid;
          try {
            vid = localStorage.getItem('pf_vid');
            if (!vid) {
              vid = (crypto.randomUUID && crypto.randomUUID()) ||
                String(Date.now()) + Math.random().toString(16).slice(2);
              localStorage.setItem('pf_vid', vid);
            }
          } catch (e) {
            vid = null;
          }

          // Send as text/plain so the browser skips the CORS preflight.
          function send(payload) {
            try {
              var body = JSON.stringify(payload);
              if (navigator.sendBeacon) {
                navigator.sendBeacon(endpoint, new Blob([body], { type: 'text/plain' }));
              } else {
                fetch(endpoint, { method: 'POST', body: body, keepalive: true, mode: 'cors' });
              }
            } catch (e) {
              /* never let analytics break the page */
            }
          }

          // 1) Pageview. `qs` carries any ?ref=/?aud= link tags for source attribution.
          send({ type: 'pageview', vid: vid, path: location.pathname, ref: document.referrer, qs: location.search });

          // 2) Section engagement — one event per section, first time it's seen.
          var seen = {};
          var queue = [];
          var flushTimer = null;

          function flush() {
            flushTimer = null;
            if (!queue.length) return;
            var batch = queue.slice();
            queue.length = 0;
            send({ type: 'section_view', vid: vid, path: location.pathname, sections: batch });
          }
          function enqueue(section) {
            queue.push(section);
            if (!flushTimer) flushTimer = setTimeout(flush, 2500);
          }

          var sections = document.querySelectorAll('section[id]');
          if ('IntersectionObserver' in window && sections.length) {
            var io2 = new IntersectionObserver(
              function (entries, obs) {
                entries.forEach(function (entry) {
                  var id = entry.target.id;
                  if (entry.isIntersecting && id && !seen[id]) {
                    seen[id] = true;
                    enqueue(id);
                    obs.unobserve(entry.target);
                  }
                });
              },
              { threshold: 0.4 }
            );
            sections.forEach(function (el) { io2.observe(el); });
          }

          // Flush any pending section views before the page goes away.
          document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'hidden') flush();
          });
        } catch (e) {
          /* analytics is best-effort; swallow everything */
        }
      })();
    </script>
  </body>
</html>
